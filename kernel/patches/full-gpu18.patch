+/* mpss ENABLED for wifi: WCN3990 wlan fw runs on the modem Q6 */
+
+/* 2023 Samsung modem image needs 160MB from 0x8d800000 (ELF phdr truth);
+ * venus/slpi regions relocated out of its way - their devices are disabled,
+ * the reservations just must not collide with anything. */
+&mpss_mem { reg = <0x0 0x8d800000 0x0 0xa000000>; };
+&venus_mem { reg = <0x0 0x9f800000 0x0 0x500000>; };
+&slpi_mem { reg = <0x0 0x9b000000 0x0 0x1400000>; };	/* 20 MB ELF span, ends at the framebuffer */
+
+/* Samsung TZ rejects the rmtfs assign-to-MSS scm call (-22) and Samsung's
+ * own dt does no vmid assign on this region - drop it so the device probes
+ * and the rmtfs daemon can serve the modem's EFS. */
+&rmtfs_mem {
+	/delete-property/ reg;
+	size = <0x0 0x400000>;
+	alignment = <0x0 0x200000>;
+	alloc-ranges = <0x0 0xb0000000 0x0 0x40000000>;
+	qcom,use-guard-pages;
+};
+/* SLPI (sensor DSP): the IMU (LSM6DSO), magnetometer and light sensor are
+ * only reachable through it. Same TZ rule as the ADSP: region >= ELF span and
+ * not overlapping anything TZ owns - AND it must sit inside the firmware zone.
+ * 0x9f800000 (just past the last firmware region) was refused with the same
+ * flattened -22; 0x9b000000 was accepted. Downstream's 0x97300000 is inside
+ * the 160 MB modem span, so it cannot go back there. */
+&remoteproc_slpi {
+	status = "okay";
+	firmware-name = "qcom/sm8150/gts6l/slpi.mdt";
+
+	/* FastRPC to the sensors PD, wired the way sdm845.dtsi does it, NOT the
+	 * way sm8150.dtsi does. The sensor process is hypervisor-bypassed on the
+	 * SMMU and uses physical addresses; attaching translated context banks
+	 * to SIDs 0x5a1..0x5a3 makes its first access fault at 0x1fffff000 and
+	 * kills sensor_process on every attach. So: one cb with no iommus, and a
+	 * DMA pool the driver assigns to the DSP VMIDs by hypervisor call. */
+	glink-edge {
+		fastrpc {
+			qcom,vmids = <QCOM_SCM_VMID_HLOS QCOM_SCM_VMID_MSS_MSA
+				      QCOM_SCM_VMID_SSC_Q6 QCOM_SCM_VMID_ADSP_Q6>;
+			memory-region = <&fastrpc_mem>;
+
+			/delete-node/ compute-cb@1;
+			/delete-node/ compute-cb@2;
+			/delete-node/ compute-cb@3;
+
+			compute-cb@0 {
+				compatible = "qcom,fastrpc-compute-cb";
+				reg = <0>;
+			};
+		};
+	};
+};
+
+/* sm8150.dtsi gives reserved-memory no label */
+&{/reserved-memory} {
+	fastrpc_mem: fastrpc {
+		compatible = "shared-dma-pool";
+		alloc-ranges = <0x0 0xb0000000 0x0 0x40000000>;
+		alignment = <0x0 0x400000>;
+		size = <0x0 0x1000000>;
+		reusable;
+	};
+};
