+/*
+ * ADSP: ENABLED, and the memory layout below is the entire reason it works.
+ *
+ * qcom_mdt_pas_init() hands TrustZone
+ *
+ *     qcom_scm_pas_mem_setup(pas_id, mem_phys, max_addr - min_addr)
+ *
+ * where the size is the image's own loadable span, computed from the ELF and
+ * completely independent of how big this reservation is. For this device's
+ * adsp.mdt (ADSP.HT.5.0.c1-00046-SM8150-1, from apnhlos) that span is
+ * 0x2700000, 39 MB.
+ *
+ * TZ then enforces two things at once, and the canonical carveout fails both:
+ *
+ *   - the region must be at least the full 39 MB span. 26 MB is refused at any
+ *     address.
+ *   - the region must not overlap anything TZ already owns. 39 MB starting at
+ *     the canonical 0x8be00000 runs into mpss_mem at 0x8d800000 where the modem
+ *     is already live, so that is refused too.
+ *
+ * So 0x8be00000 can never work: too small as declared, and too big to fit.
+ * Both failures surface as the same "-22 setting up firmware", because TZ
+ * answers 0xffcfffba and qcom_scm_remap_error() does not know that code, so it
+ * flattens it (and everything else it does not know) onto -EINVAL. That is why
+ * the error looked identical for every experiment.
+ *
+ * Measured by making the SCM call raw from a test module, all after a
+ * successful pas_init_image:
+ *
+ *     0x8be00000  26 MB  refused      0x98900000  26 MB  refused
+ *     0x8be00000  39 MB  refused      0x98900000  39 MB  ACCEPTED
+ *                                     0x98900000  40 MB  accepted
+ *                                     0x98900000  45 MB  accepted
+ *
+ * Do not "tidy" this back to the canonical address. Note also the ceiling:
+ * usable DRAM ends near 0x9ff90000 with a hole above it, so a 39 MB region at
+ * 0x9f800000 runs off the end of RAM and is refused for that reason instead.
+ *
+ * mpss_mem is 160 MB for exactly the same reason: modem.mdt's span is exactly
+ * 0xa000000. Same rule, different subsystem, found the hard way twice.
+ *
+ * Firmware is this device's own adsp.mdt plus segments from apnhlos, not the
+ * Surface Duo path sm8150.dtsi defaults to.
+ */
+&adsp_mem { reg = <0x0 0x98900000 0x0 0x2700000>; };	/* exactly the 39 MB ELF span */
+
+/*
+ * cdsp is not used, so park its reservation on the old ADSP carveout. That
+ * keeps 0x8be00000 carved out of System RAM, which matters because Samsung's
+ * firmware still believes that region belongs to the ADSP.
+ */
+&cdsp_mem { reg = <0x0 0x8be00000 0x0 0x1a00000>; };
+
+&remoteproc_adsp {
+	status = "okay";
+	firmware-name = "qcom/sm8150/gts6l/adsp.mdt";
+
+	/*
+	 * APR, the audio packet router, rides the GLINK edge the ADSP brings up.
+	 * sm8150.dtsi has no apr node at all; this is the sdm845/sm8250 shape,
+	 * which is portable because the ADSP side of it is firmware, not SoC.
+	 *
+	 * The q6asm SID is inferred, not documented: sdm845 pairs fastrpc
+	 * compute-cb 0x1823 with q6asm 0x1821, and our fastrpc cbs are 0x1b23,
+	 * 0x1b24 and 0x1b25, so the matching q6asm SID is 0x1b21. If that is
+	 * wrong it shows up as an apps_smmu context fault on playback, not at
+	 * probe.
+	 *
+	 * qcom,protection-domain is deliberately left off. Upstream sets
+	 * "avs/audio"/"msm/adsp/audio_pd", which makes apr wait on a PDR lookup
+	 * served by pd-mapper. It is optional, and leaving it out lets these
+	 * probe as soon as the channel opens rather than adding a userspace
+	 * dependency to the first bring-up.
+	 */
+	glink-edge {
+		apr {
+			compatible = "qcom,apr-v2";
