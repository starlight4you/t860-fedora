+	for_each_rtd_codec_dais(rtd, j, cdai) {
+		/*
+		 * Four amps, a stereo stream, and only `channels` slots carry
+		 * anything, so the two speaker pairs each take the same two
+		 * channels: amps 0 and 2 get channel 0, amps 1 and 3 get
+		 * channel 1. Mapping amp N to slot N instead parks half the
+		 * amps on slots nothing was written to, and on this tablet both
+		 * of the amps that did get audio sit at the same end, so it
+		 * plays out of one side only.
+		 *
+		 * The result is then scaled into the amp's own slot width, per
+		 * the TDM_SLOT_WIDTH comment. cs35l41 has no set_tdm_slot op, so
+		 * this goes in through set_channel_map.
+		 */
+		unsigned int slot = (j % channels) * per_slot;
+
+		/*
+		 * cs35l41 has TWO clock entry points and needs both. The
+		 * component one points its PLL at the ASP bit clock (clk id 0
+		 * is CS35L41_CLKID_SCLK), the DAI one sets the clock monitor
+		 * window. Miss them and the amp never finishes powering up:
